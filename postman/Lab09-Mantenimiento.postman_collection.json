{
  "info": {
    "name": "Lab 09 | Gestión de mantenimiento de equipos",
    "description": "Jara Ayala Ivan Rodrigo. Ejecuta las carpetas en orden. La carpeta 03 elimina únicamente los registros creados en el flujo de esta ejecución.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "clienteUrl",
      "value": "http://127.0.0.1:8081"
    },
    {
      "key": "equipoUrl",
      "value": "http://127.0.0.1:8082"
    },
    {
      "key": "ordenUrl",
      "value": "http://127.0.0.1:8083"
    },
    {
      "key": "idCliente",
      "value": ""
    },
    {
      "key": "idEquipo",
      "value": ""
    },
    {
      "key": "idOrden",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Flujo principal",
      "description": "Crea un cliente, su equipo y su orden. Cambia y verifica el estado. Conserva los registros para revisarlos en phpMyAdmin.",
      "item": [
        {
          "name": "01 Crear cliente",
          "request": {
            "method": "POST",
            "url": "{{clienteUrl}}/clientes",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Lucía\",\n  \"apellidos\": \"Torres\",\n  \"correo\": \"lucia.torres@example.com\",\n  \"telefono\": \"999123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"idCliente\");",
                  "pm.collectionVariables.unset(\"idEquipo\");",
                  "pm.collectionVariables.unset(\"idOrden\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "    const id = pm.response.json().id;",
                  "    pm.test(\"ID generado\", () => pm.expect(id).to.be.above(0));",
                  "    pm.collectionVariables.set(\"idCliente\", String(id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Listar clientes",
          "request": {
            "method": "GET",
            "url": "{{clienteUrl}}/clientes",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"El registro está en la lista\", () => pm.expect(pm.response.json().some(row => row.id === Number(pm.collectionVariables.get(\"idCliente\")))).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Consultar cliente por ID",
          "request": {
            "method": "GET",
            "url": "{{clienteUrl}}/clientes/{{idCliente}}",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Campo correo\", () => pm.expect(pm.response.json().correo).to.eql(\"lucia.torres@example.com\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Actualizar cliente",
          "request": {
            "method": "PUT",
            "url": "{{clienteUrl}}/clientes/{{idCliente}}",
