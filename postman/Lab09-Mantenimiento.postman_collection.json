            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Lucía\",\n  \"apellidos\": \"Torres\",\n  \"correo\": \"lucia.torres@example.com\",\n  \"telefono\": \"999123457\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Campo telefono\", () => pm.expect(pm.response.json().telefono).to.eql(\"999123457\"));"
                ]
              }
            }
          ]
        },
