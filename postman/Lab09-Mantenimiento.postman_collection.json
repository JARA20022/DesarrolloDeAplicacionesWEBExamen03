                  "}",
                  "pm.test(\"Campo estado\", () => pm.expect(pm.response.json().estado).to.eql(\"RECIBIDO\"));",
                  "pm.test(\"Campo fechaIngreso\", () => pm.expect(pm.response.json().fechaIngreso).to.eql(\"2026-11-06\"));",
                  "pm.test(\"Orden asociada al equipo\", () => pm.expect(pm.response.json().idEquipo).to.eql(Number(pm.collectionVariables.get(\"idEquipo\"))));"
                ]
